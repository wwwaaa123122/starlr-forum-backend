// Starlr Forum — 经典版前端 Worker（frontend.182030.xyz）
//
// 托管 starlr-forum-frontend（经典版，shadcn/ui 直角风格）构建产物 dist-f，
// 浏览器跨域直连独立后端 forum-backend（i.182030.xyz）。
// 零数据绑定；src/index-f.ts 复用 f 站薄 SEO 入口（robots/sitemap/feed 302 主域）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/index-f.ts",
  "name": "forum-frontend-classic",
  "routes": [{ "pattern": "frontend.182030.xyz", "custom_domain": true }],
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "../starlr-forum-frontend/dist-f",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/robots.txt", "/sitemap.xml", "/feed.xml"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "SITE_URL": "https://frontend.182030.xyz",
    "CANONICAL_SITE_URL": "https://starlr.tech"
  }
}
