{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy -c wrangler.prod.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "node scripts/setup.mjs",
    "generate:keys": "node scripts/generate-jwt-keys.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote -c wrangler.prod.jsonc"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.147.0"
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  }
}
