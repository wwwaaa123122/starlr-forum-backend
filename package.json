{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply xingchen-forum-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply xingchen-forum-db --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:keys": "node scripts/generate-jwt-keys.mjs"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20251004.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.147.0"
  }
}
