// Starlr Forum — 纯前端 Worker（f.182030.xyz）
//
// 托管静态资源（frontend-x 构建产物 dist-f，构建时 VITE_API_BASE=https://i.182030.xyz），
// 无任何 D1/KV/R2 数据绑定；浏览器跨域直连独立后端 forum-backend（i.182030.xyz）。
// src/index-f.ts 是薄 SEO 入口：仅 /robots.txt、/sitemap.xml、/feed.xml 进 Worker（run_worker_first 白名单），
// 其余路径由 assets 层直出（SPA fallback 照旧）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/index-f.ts",
  "name": "forum-frontend",
  "routes": [{ "pattern": "f.182030.xyz", "custom_domain": true }],
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "../frontend-x/dist-f",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/robots.txt", "/sitemap.xml", "/feed.xml"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // 主站地址：sitemap/feed 的 301 目标（自部署改成自己的主域）
    "SITE_URL": "https://f.182030.xyz",
    "CANONICAL_SITE_URL": "https://starlr.tech"
  }
}
