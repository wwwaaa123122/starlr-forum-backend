# 本地开发环境变量示例
# 复制为 backend/.dev.vars（已被 .gitignore 忽略，绝不提交）
# 生成密钥：node scripts/generate-jwt-keys.mjs（仓库内 scripts/ 目录）

JWT_SIGNING_KEYS=[{"kid":"dev-001","jwk":{"kty":"RSA","n":"...","e":"AQAB","d":"...","p":"...","q":"...","dp":"...","dq":"...","qi":"..."},"active":true}]
TURNSTILE_DISABLED=true

# 邮件（Resend）：本地默认写内存，不真实外发；生产用 wrangler secret put RESEND_API_KEY
MAIL_TRANSPORT=memory
# MAIL_FROM=星辰旅人论坛 <no-reply@182030.xyz>
# 如需本地启用 Turnstile：
